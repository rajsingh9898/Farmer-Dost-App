# =============================================================================
# Farmer Dost App — Local Environment Variables Template
# Copy this file to .env and configure your local Firebase and backend parameters.
# NEVER commit your real .env file or private keys to GitHub.
# =============================================================================

# Application Environment (development / staging / production)
ENVIRONMENT=development

# Firebase Project Configuration (from Firebase Console Project Settings)
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Backend & Admin SDK Configuration
FIREBASE_SERVICE_ACCOUNT_KEY=backend/serviceAccountKey.json

# Code & QR Generator Settings (Day 18)
QR_OUTPUT_DIR=backend/qr_output
QR_ERROR_CORRECTION=M
GENERATE_CHECKSUM=false

# Regional & Localization Defaults (Punjab)
DEFAULT_LANGUAGE=en
DEFAULT_COUNTRY_CODE=+91
DEFAULT_REGION=Punjab